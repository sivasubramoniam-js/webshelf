        "Heading": "\u0391\u03c1\u03c7\u03b9\u03ba\u03ae - \u03a6\u03b1\u03c1\u03bc\u03b1\u03ba\u03bf\u03b2\u03b9\u03bf\u03bc\u03b7\u03c7\u03b1\u03bd\u03af\u03b1 \u039a\u039f\u03a0\u0395\u03a1",
        "Abstract": "\u0397 \u039a\u039f\u03a0\u0395\u03a1    \n\u0391\u03b4\u03b9\u03ac\u03bb\u03b5\u03b9\u03c0\u03c4\u03b7\n\u03bc\u03ad\u03c7\u03c1\u03b9 \u03c3\u03ae\u03bc\u03b5\u03c1\u03b1\n\u03b7 \u03c0\u03b1\u03c1\u03bf\u03c5\u03c3\u03af\u03b1 \u03c4\u03b7\u03c2  \n\u0391\u03c0\u03cc \u03c4\u03bf 1936, \u03b7 \u039a\u039f\u03a0\u00c9\u03a1\u00a0\u0391.\u0395. (KOP\u00c9R) \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03af \u03bc\u03af\u03b1 \u03b1\u03bc\u03b9\u03b3\u03ce\u03c2 \u03b5\u03bb\u03bb\u03b7\u03bd\u03b9\u03ba\u03ae \u03c6\u03b1\u03c1\u03bc\u03b1\u03ba\u03b5\u03c5\u03c4\u03b9\u03ba\u03ae \u03b5\u03c4\u03b1\u03b9\u03c1\u03b5\u03af\u03b1 \u03bc\u03b5 \u03b5\u03be\u03b5\u03b9\u03b4\u03af\u03ba\u03b5\u03c5\u03c3\u03b7 \u03c3\u03c4\u03b1 \u03c3\u03c4\u03b5\u03af\u03c1\u03b1 \u03c6\u03b1\u03c1\u03bc\u03b1\u03ba\u03b5\u03c5\u03c4\u03b9\u03ba\u03ac \u03c0\u03c1\u03bf\u03ca\u03cc\u03bd\u03c4\u03b1.\n\u039f\u03b9 \u03c0\u03b1\u03c1\u03b1\u03b3\u03c9\u03b3\u03b9\u03ba\u03ad\u03c2 \u03c4\u03b7\u03c2 \u03b5\u03b3\u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03ac\u03c3\u03b5\u03b9\u03c2 \u03c0\u03b5\u03c1\u03b9\u03bb\u03b1\u03bc\u03b2\u03ac\u03bd\u03bf\u03c5\u03bd 5 \u03b5\u03be\u03b5\u03b9\u03b4\u03b9\u03ba\u03b5\u03c5\u03bc\u03ad\u03bd\u03b5\u03c2 \u03b3\u03c1\u03b1\u03bc\u03bc\u03ad\u03c2 \u03c0\u03b1\u03c1\u03b1\u03b3\u03c9\u03b3\u03ae\u03c2 \u03b3\u03b9\u03b1 \u03bf\u03c6\u03b8\u03b1\u03bb\u03bc\u03b9\u03ba\u03ac \u03b4\u03b9\u03b1\u03bb\u03cd\u03bc\u03b1\u03c4\u03b1, \u03c0\u03b1\u03c1\u03b5\u03bd\u03c4\u03b5\u03c1\u03b9\u03ba\u03ac \u03bc\u03b5\u03b3\u03ac\u03bb\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03bc\u03b9\u03ba\u03c1\u03ae\u03c2 \u03ba\u03bb\u03af\u03bc\u03b1\u03ba\u03b1\u03c2, \u03be\u03b7\u03c1\u03ad\u03c2 \u03c3\u03ba\u03cc\u03bd\u03b5\u03c2",
