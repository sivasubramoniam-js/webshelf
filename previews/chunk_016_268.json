        "Abstract": "\u2713 \u0645\u0646\u062a\u062c\u0627\u062a \u0623\u0635\u0644\u064a\u0629 \u0636\u0645\u0627\u0646 \u062d\u0642\u064a\u0642\u064a \ud83d\ude9a \u0634\u062d\u0646 \u0633\u0631\u064a\u0639 \u0644\u0643\u0644 \u0627\u0644\u0645\u062d\u0627\u0641\u0638\u0627\u062a \ud83d\udd27 \u062a\u0631\u0643\u064a\u0628 \u0648\u062f\u0639\u0645 \u0641\u0631\u064a\u0642 \u0645\u062a\u062e\u0635\u0635 \ud83d\udcb3 \u062f\u0641\u0639 \u0622\u0645\u0646 \u0637\u0631\u0642 \u062f\u0641\u0639 \u0645\u062a\u0639\u062f\u062f\u0629 \u260e \u0627\u0633\u062a\u0634\u0627\u0631\u0629 \u0645\u062c\u0627\u0646\u064a\u0629 \u0642\u0628\u0644 \u0627\u0644\u0634\u0631\u0627\u0621 \u062a\u0633\u0648\u0642 \u062d\u0633\u0628 \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u0627\u062e\u062a\u0627\u0631 \u0627\u0644\u0642\u0633\u0645 \u0627\u0644\u0645\u0646\u0627\u0633\u0628 \u0644\u0627\u062d\u062a\u064a\u0627\u062c\u0643 \u0639\u0631\u0636 \u0643\u0644 \u0627\u0644\u062a\u0635\u0646\u064a\u0641\u0627\u062a \u2190 \u0643\u0627\u0645\u064a\u0631\u0627\u062a \u0645\u0631\u0627\u0642\u0628\u0629 \u0623\u0642\u0641\u0627\u0644 \u0630\u0643\u064a\u0629 Smart Locks \u0645\u0646\u0632\u0644 \u0630\u0643\u064a Smart Home \u0644\u0627\u0628\u062a\u0648\u0628 Laptops \u0637\u0627\u0628\u0639\u0627\u062a Printers \u0627\u0643\u0633\u0633\u0648\u0627\u0631\u0627\u062a Accessories \u0627\u0644\u0623\u0643\u062b\u0631 \u0645\u0628\u064a\u0639\u064b\u0627 \u062a\u0635\u0641\u062d \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0627\u0644\u0623\u0643\u062b\u0631 \u0645\u0628\u064a\u0639\u064b\u0627 \u0644\u062f\u064a\u0646\u0627 \u0639\u0631\u0636 \u0627\u0644\u0643\u0644 \u2190 Security Solutions \u0643\u0627\u0645\u064a\u0631\u0627\u062a \u0645\u0631\u0627\u0642\u0628\u0629 \u0628\u0627\u062d\u062a\u0631\u0627\u0641\u064a\u0629 \u0623\u0639\u0644\u0649 \u0623\u0646\u0638\u0645\u0629 CCTV \u0644\u0644\u0645\u0646\u0627\u0632\u0644 \u0648\u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0628\u062c\u0648\u062f\u0629 \u0639\u0627\u0644\u064a\u0629\u060c \u0645\u062a\u0627\u0628\u0639\u0629 \u0645\u0646 \u0627\u0644\u0645\u0648\u0628\u0627\u064a\u0644\u060c \u0648\u062a\u0631\u0643\u064a\u0628 \u0627\u062d\u062a\u0631\u0627\u0641\u064a \u064a\u0646\u0627\u0633\u0628 \u0627\u062d\u062a\u064a\u0627\u062c\u0643. \u062a\u0635\u0641\u062d \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627\u062a \u2190 \u062d\u0644\u0648\u0644 \u0627\u0644\u0623\u0645\u0627\u0646 \u0643\u0627\u0645\u064a\u0631\u0627\u062a \u0627\u0644\u0645\u0631\u0627\u0642\u0628\u0629 Camera CCTV \u0639\u0631\u0636 \u0627\u0644\u0643\u0644 \u2190 \u0627\u0633\u062a\u0634\u0627\u0631\u0629 \u0645\u062c\u0627\u0646\u064a\u0629 \u0639\u0628\u0631 \u0648\u0627\u062a\u0633\u0627\u0628 \u0645\u062d\u062a\u0627\u062c \u0646\u0638\u0627\u0645 \u0623\u0645\u0627\u0646 \u0643\u0627\u0645\u0644 \u0644\u0634\u0631\u0643\u062a\u0643 \u0623\u0648 \u0628\u064a\u062a\u0643\u061f \u0641\u0631\u064a\u0642\u0646\u0627 \u064a\u0633\u0627\u0639\u062f\u0643 \u0641\u064a \u0627\u062e\u062a\u064a\u0627\u0631 \u0648\u062a\u0631\u0643\u064a\u0628 \u0643\u0627\u0645\u064a\u0631\u0627\u062a \u0627\u0644\u0645\u0631\u0627\u0642\u0628\u0629\u060c \u0627\u0644\u0623\u0642\u0641\u0627\u0644 \u0627\u0644\u0630\u0643\u064a\u0629\u060c \u0648\u0623\u0646\u0638\u0645\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u062f\u062e\u0648\u0644 \u0628\u0623\u0641\u0636\u0644 \u062a\u0643\u0644\u0641\u0629 \u0648\u0628\u0623\u0639\u0644\u0649 \u0643\u0641\u0627\u0621\u0629. \u0627\u0637\u0644\u0628 \u0627\u0633\u062a\u0634\u0627\u0631\u0629 \u0645\u062c\u0627\u0646\u064a\u0629 \u0648\u0627\u062a\u0633\u0627\u0628 \u2190 \u0643\u0627\u0645\u064a\u0631\u0627\u062a \u0645\u0631\u0627\u0642\u0628\u0629 \u0623\u0642\u0641\u0627\u0644 \u0630\u0643\u064a\u0629 Access Control \u0623\u062d\u062f\u062b \u062a\u0643\u0646\u0648\u0644\u0648\u062c\u064a\u0627 \u0627\u0646\u0638\u0645\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0627\u0628\u0648\u0627\u0628 Smart lock \u0639\u0631\u0636 \u0627\u0644\u0643\u0644 \u2190 \u0623\u0645\u0627\u0646 \u0628\u064a\u062a\u0643 \u0645\u0634 \u0631\u0641\u0627\u0647\u064a\u0629 \u0633\u0645\u0627\u0631\u062a \u0647\u0648\u0645 \u0639\u0631\u0636 \u0627\u0644\u0643\u0644 \u2190 \u0646\u0648\u0641\u0631 \u0634\u0627\u0634\u0627\u062a \u062a\u0641\u0627\u0639\u0644\u064a\u0629 \u0630\u0643\u064a\u0629 \u0644\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u0627\u062a \u0648\u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0648\u0627\u0644\u0639\u0631\u0648\u0636 \u0627\u0644\u062a\u0642\u062f\u064a\u0645\u064a\u0629 \u0634\u0627\u0634\u0627\u062a \u062a\u0641\u0627\u0639\u0644\u064a\u0629 \u0639\u0631\u0636 \u0627\u0644\u0643\u0644 \u2190 New Arrivals \u0644\u0627\u0628\u062a\u0648\u0628\u0627\u062a \u0644\u0644\u0634\u063a\u0644 \u0648\u0627\u0644\u062f\u0631\u0627\u0633\u0629 \u0627\u062e\u062a\u064a\u0627\u0631\u0627\u062a \u0645\u0646\u0627\u0633\u0628\u0629 \u0644\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u064a\u0648\u0645\u064a\u060c \u0627\u0644\u0634\u0631\u0643\u0627\u062a\u060c \u0627\u0644\u062f\u0631\u0627\u0633\u0629\u060c \u0648\u0627\u0644\u062c\u0631\u0627\u0641\u064a\u0643 \u0628\u0623\u062f\u0627\u0621 \u0642\u0648\u064a \u0648\u0623\u0633\u0639\u0627\u0631 \u0645\u0645\u064a\u0632\u0629. \u062a\u0635\u0641\u062d \u0627\u0644\u0644\u0627\u0628\u062a\u0648\u0628\u0627\u062a \u2190 LAPTOP \u0623\u062e\u062a\u0631 \u0645\u0646 \u0645\u062c\u0645\u0648\u0639\u0647 \u0645\u0645\u064a\u0632\u0629 \u0645\u0646 \u0627\u0644\u0644\u0627\u0628 \u062a\u0648\u0628 \u0639\u0631\u0636 \u0627\u0644\u0643\u0644 \u2190 \u0645\u0627\u0631\u0643\u0627\u062a \u0645\u0648\u062b\u0648\u0642\u0629 \u0646\u062a\u0639\u0627\u0645\u0644 \u0645\u0639 \u0623\u0641\u0636\u0644 \u0627\u0644\u0628\u0631\u0627\u0646\u062f\u0627\u062a Printers \u0623\u062e\u062a\u0631 \u0645\u0646 \u0645\u062c\u0645\u0648\u0639\u0647 \u0645\u0645\u064a\u0632\u0629 \u0645\u0646 \u0627\u0644\u0637\u0627\u0628\u0639\u0627\u062a \u0639\u0631\u0636 \u0627\u0644\u0643\u0644 \u2190 \u2605\u2605\u2605\u2605\u2605 \u062e\u062f\u0645\u0629 \u0645\u0645\u062a\u0627\u0632\u0629 \u0648\u062a\u0631\u0643\u064a\u0628 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627\u062a \u0643\u0627\u0646 \u0645\u0646\u0638\u0645 \u062c\u062f\u064b\u0627\u060c \u0648\u0627\u0644\u0641\u0631\u064a\u0642 \u0633\u0627\u0639\u062f\u0646\u064a \u0623\u062e\u062a\u0627\u0631 \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0645\u0646\u0627\u0633\u0628. \u0645 \u0645\u062d\u0645\u062f \u0623\u062d\u0645\u062f \u0639\u0645\u064a\u0644 \u0645\u0646\u0632\u0644\u064a \u2605\u2605\u2605\u2605\u2605 \u0627\u0634\u062a\u0631\u064a\u0646\u0627 \u0637\u0627\u0628\u0639\u0627\u062a \u0644\u0644\u0634\u0631\u0643\u0629\u060c \u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0645\u0646\u0627\u0633\u0628\u0629 \u0648\u062e\u062f\u0645\u0629 \u0645\u0627 \u0628\u0639\u062f \u0627\u0644\u0628\u064a\u0639 \u0645\u0645\u062a\u0627\u0632\u0629. \u0633 \u0633\u0627\u0631\u0629 \u0639\u0644\u064a \u0634\u0631\u0643\u0629 \u062a\u062c\u0627\u0631\u064a\u0629 \u2605\u2605\u2605\u2605\u2606 \u0627\u0644\u0645\u0648\u0642\u0639 \u0645\u0646\u0638\u0645 \u0648\u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0648\u0627\u0636\u062d\u0629\u060c \u0648\u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0639\u0644\u0649 \u0648\u0627\u062a\u0633\u0627\u0628 \u0643\u0627\u0646 \u0633\u0631\u064a\u0639 \u0648\u0645\u0641\u064a\u062f. \u0623 \u0623\u062d\u0645\u062f \u0633\u0645\u064a\u0631 \u0639\u0645\u064a\u0644 \u0623\u0648\u0646\u0644\u0627\u064a\u0646 \u2605\u2605\u2605\u2605\u2605 \u0631\u0643\u0628\u0646\u0627 \u0646\u0638\u0627\u0645 \u0643\u0627\u0645\u064a\u0631\u0627\u062a \u0644\u0644\u0645\u062e\u0632\u0646\u060c \u0627\u0644\u0635\u0648\u0631\u0629 \u0648\u0627\u0636\u062d\u0629 \u062c\u062f\u064b\u0627 \u0648\u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u0645\u0646 \u0627\u0644\u0645\u0648\u0628\u0627\u064a\u0644 \u0645\u0645\u062a\u0627\u0632\u0629. \u062e \u062e\u0627\u0644\u062f \u0645\u062d\u0645\u0648\u062f \u0635\u0627\u062d\u0628 \u0646\u0634\u0627\u0637 \u062a\u062c\u0627\u0631\u064a \u2605\u2605\u2605\u2605\u2605 \u0627\u0644\u062f\u0639\u0645 \u0627\u0644\u0641\u0646\u064a \u0645\u062d\u062a\u0631\u0645 \u0648\u0631\u062f \u0628\u0633\u0631\u0639\u0629\u060c \u0648\u0633\u0627\u0639\u062f\u0648\u0646\u064a \u0623\u0641\u0647\u0645 \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u0642\u0628\u0644 \u0627\u0644\u0634\u0631\u0627\u0621. \u0646 \u0646\u062f\u0649 \u062d\u0633\u0646 \u0639\u0645\u064a\u0644\u0629 \u0623\u0648\u0646\u0644\u0627\u064a\u0646 \u2605\u2605\u2605\u2605\u2606 \u0627\u0634\u062a\u0631\u064a\u062a \u0644\u0627\u0628\u062a\u0648\u0628 \u0644\u0644\u0634\u063a\u0644 \u0648\u0643\u0627\u0646 \u0645\u0637\u0627\u0628\u0642 \u0644\u0644\u0648\u0635\u0641\u060c \u0627\u0644\u062a\u063a\u0644\u064a\u0641 \u0643\u0648\u064a\u0633 \u0648\u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0648\u0635\u0644 \u0641\u064a \u0627\u0644\u0645\u0639\u0627\u062f. \u064a \u064a\u0648\u0633\u0641 \u0639\u0627\u062f\u0644 Freelancer \u2605\u2605\u2605\u2605\u2605 \u0631\u0643\u0628\u0648\u0627 \u0644\u0646\u0627 Smart Lock \u0648\u0643\u0627\u0646 \u0627\u0644\u062a\u0639\u0627\u0645\u0644 \u0627\u062d\u062a\u0631\u0627\u0641\u064a\u060c \u0648\u0627\u0644\u0634\u0631\u062d \u0628\u0639\u062f \u0627\u0644\u062a\u0631\u0643\u064a\u0628 \u0643\u0627\u0646 \u0648\u0627\u0636\u062d. \u0631 \u0631\u064a\u0645 \u0645\u0635\u0637\u0641\u0649 \u0639\u0645\u064a\u0644\u0629 \u0645\u0646\u0632\u0644\u064a\u0629 \u2605\u2605\u2605\u2605\u2605 \u062a\u0639\u0627\u0645\u0644 \u0631\u0627\u0642\u064a \u0648\u0623\u0633\u0639\u0627\u0631 \u0645\u0646\u0627\u0633\u0628\u0629\u060c \u0648\u0641\u0631\u0648\u0627 \u0644\u0646\u0627 \u0637\u0627\u0628\u0639\u0627\u062a \u0648\u0623\u062d\u0628\u0627\u0631 \u0644\u0644\u0634\u0631\u0643\u0629 \u0641\u064a \u0648\u0642\u062a \u0642\u0635\u064a\u0631. \u0639 \u0639\u0645\u0631 \u0641\u062a\u062d\u064a \u0645\u062f\u064a\u0631 \u0645\u0643\u062a\u0628 \u2605\u2605\u2605\u2605\u2606 \u062c\u0648\u062f\u0629 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0643\u0648\u064a\u0633\u0629 \u062c\u062f\u064b\u0627\u060c \u0648\u0627\u0644\u0623\u0647\u0645 \u0625\u0646 \u0641\u064a\u0647 \u0645\u062a\u0627\u0628\u0639\u0629 \u0628\u0639\u062f \u0627\u0644\u0628\u064a\u0639 \u0648\u062f\u0647 \u0641\u0631\u0642 \u0645\u0639\u0627\u064a\u0627. \u062f \u062f\u064a\u0646\u0627 \u0633\u0627\u0645\u064a \u0639\u0645\u064a\u0644\u0629 \u062f\u0627\u0626\u0645\u0629 \u0627\u0633\u062a\u0634\u0627\u0631\u0629 \u0645\u062c\u0627\u0646\u064a\u0629 \u0644\u0633\u0647 \u0645\u062d\u062a\u0627\u0631 \u062a\u062e\u062a\u0627\u0631 \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u061f \u0641\u0631\u064a\u0642\u0646\u0627 \u064a\u0633\u0627\u0639\u062f\u0643 \u062a\u062e\u062a\u0627\u0631 \u0623\u0641\u0636\u0644 \u062d\u0644 \u062d\u0633\u0628 \u0627\u062d\u062a\u064a\u0627\u062c\u0643\u060c \u0633\u0648\u0627\u0621 \u0643\u0627\u0645\u064a\u0631\u0627\u062a \u0645\u0631\u0627\u0642\u0628\u0629\u060c Smart Lock\u060c \u0637\u0627\u0628\u0639\u0627\u062a\u060c \u0623\u0648 \u0644\u0627\u0628\u062a\u0648\u0628\u0627\u062a. \u0627\u062e\u062a\u064a\u0627\u0631 \u0645\u0646\u0627\u0633\u0628 \u0623\u0641\u0636\u0644 \u062a\u0643\u0644\u0641\u0629 \u062f\u0639\u0645 \u0641\u0646\u064a \u062a\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627 \u0627\u0644\u0622\u0646 \u2190 \u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0634\u0627\u0626\u0639\u0629 \u0625\u062c\u0627\u0628\u0627\u062a \u0633\u0631\u064a\u0639\u0629 \u0639\u0644\u0649 \u0623\u0647\u0645 \u0627\u0633\u062a\u0641\u0633\u0627\u0631\u0627\u062a\u0643 \u0647\u0644 \u062a\u0648\u0641\u0631\u0648\u0646 \u062a\u0631\u0643\u064a\u0628 \u0643\u0627\u0645\u064a\u0631\u0627\u062a \u0627\u0644\u0645\u0631\u0627\u0642\u0628\u0629\u061f + \u0646\u0639\u0645\u060c \u0646\u0648\u0641\u0631 \u062e\u062f\u0645\u0629 \u062a\u0631\u0643\u064a\u0628 \u0643\u0627\u0645\u064a\u0631\u0627\u062a \u0627\u0644\u0645\u0631\u0627\u0642\u0628\u0629 \u0644\u0644\u0645\u0646\u0627\u0632\u0644 \u0648\u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0645\u0639 \u0645\u0639\u0627\u064a\u0646\u0629 \u0648\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0645\u0646\u0627\u0633\u0628 \u062d\u0633\u0628 \u0627\u0644\u0645\u0643\u0627\u0646. \u0647\u0644 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0639\u0644\u064a\u0647\u0627 \u0636\u0645\u0627\u0646\u061f + \u0646\u0639\u0645\u060c \u0623\u063a\u0644\u0628 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0645\u062a\u0648\u0641\u0631\u0629 \u0628\u0636\u0645\u0627\u0646 \u062d\u0633\u0628 \u0646\u0648\u0639 \u0627\u0644\u0645\u0646\u062a\u062c \u0648\u0627\u0644\u0645\u0627\u0631\u0643\u0629\u060c \u0648\u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u062a\u0623\u0643\u062f \u0645\u0646 \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0636\u0645\u0627\u0646 \u0642\u0628\u0644 \u0627\u0644\u0634\u0631\u0627\u0621. \u0647\u0644 \u064a\u0645\u0643\u0646 \u0637\u0644\u0628 \u0627\u0633\u062a\u0634\u0627\u0631\u0629 \u0642\u0628\u0644 \u0627\u0644\u0634\u0631\u0627\u0621\u061f + \u0628\u0627\u0644\u062a\u0623\u0643\u064a\u062f\u060c \u064a\u0645\u0643\u0646\u0643 \u0637\u0644\u0628 \u0627\u0633\u062a\u0634\u0627\u0631\u0629 \u0644\u0645\u0633\u0627\u0639\u062f\u062a\u0643 \u0641\u064a \u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627\u062a\u060c \u0627\u0644\u0623\u0642\u0641\u0627\u0644 \u0627\u0644\u0630\u0643\u064a\u0629\u060c \u0627\u0644\u0637\u0627\u0628\u0639\u0627\u062a\u060c \u0623\u0648 \u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0644\u0627\u0628\u062a\u0648\u0628 \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629. \u0647\u0644 \u064a\u0648\u062c\u062f \u0634\u062d\u0646 \u0644\u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u062d\u0627\u0641\u0638\u0627\u062a\u061f + \u0646\u0639\u0645\u060c \u0646\u0648\u0641\u0631 \u0634\u062d\u0646 \u0644\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0625\u0644\u0649 \u0645\u062e\u062a\u0644\u0641 \u0627\u0644\u0645\u062d\u0627\u0641\u0638\u0627\u062a\u060c \u0648\u062a\u062e\u062a\u0644\u0641 \u0645\u062f\u0629 \u0627\u0644\u0634\u062d\u0646 \u062d\u0633\u0628 \u0645\u0648\u0642\u0639\u0643 \u0648\u0646\u0648\u0639 \u0627\u0644\u0645\u0646\u062a\u062c. \u0647\u0644 \u064a\u0645\u0643\u0646 \u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627\u062a \u0645\u0646 \u0627\u0644\u0645\u0648\u0628\u0627\u064a\u0644\u061f + \u0646\u0639\u0645\u060c \u064a\u062a\u0645 \u0636\u0628\u0637 \u0627\u0644\u0646\u0638\u0627\u0645 \u0628\u062d\u064a\u062b \u064a\u0645\u0643\u0646\u0643 \u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627\u062a \u0645\u0646 \u0627\u0644\u0645\u0648\u0628\u0627\u064a\u0644 \u0628\u0639\u062f \u0627\u0644\u062a\u0631\u0643\u064a\u0628 \u0648\u0627\u0644\u0625\u0639\u062f\u0627\u062f.",
