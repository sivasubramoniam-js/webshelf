        "Heading": "Barhome \u05e0\u05d3\u05dc\u05df \u05d1\u05d5\u05d8\u05d9\u05e7.",
        "Abstract": "\u05de\u05e9\u05db\u05d9\u05ea 9 \u05d4\u05e8\u05e6\u05dc\u05d9\u05d4 \u05e7\u05d5\u05de\u05d4 4, \u05d4\u05e8\u05e6\u05dc\u05d9\u05d4 -- 099551235 -- \n\n\n&nbsp;\n\n\nBARHOME\n\n\u05e0\u05d3\u05dc\"\u05df \u05d1\u05d5\u05d8\u05d9\u05e7 - \u05d4\u05de\u05e7\u05e6\u05d5\u05e2\u05e0\u05d5\u05ea \u05e9\u05e2\u05d5\u05e9\u05d4 \u05d0\u05ea \u05d4\u05d4\u05d1\u05d3\u05dc\n\u05dc\u05d9\u05d5\u05d5\u05d9 \u05d0\u05d9\u05e9\u05d9 \u05e9\u05dc \u05d2\u05d9\u05d0 \u05d1\u05e8\u05d4\u05d5\u05dd (MBA) \u05d1\u05e2\u05e1\u05e7\u05d0\u05d5\u05ea \u05d4\u05de\u05d5\u05e8\u05db\u05d1\u05d5\u05ea \u05d5\u05d4\u05d7\u05e9\u05d5\u05d1\u05d5\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05d7\u05d9\u05d9\u05db\u05dd.\n\n\n\n\n\n\n\u05e0\u05e2\u05d9\u05dd \u05dc\u05d4\u05db\u05d9\u05e8, \u05d2\u05d9\u05d0 \u05d1\u05e8\u05d4\u05d5\u05dd \u05d5\u05e6\u05d5\u05d5\u05ea BARHOME\n \u05de\u05e9\u05e8\u05d3\u05e0\u05d5 \u05d4\u05d5\u05d0 \u05dc\u05d0 \u05e2\u05d5\u05d3 \u05de\u05e9\u05e8\u05d3 \u05ea\u05d9\u05d5\u05d5\u05da \u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9. \u05d0\u05e0\u05d7\u05e0\u05d5 \u05de\u05e9\u05e8\u05d3 \u05d1\u05d5\u05d8\u05d9\u05e7 \u05de\u05e9\u05e4\u05d7\u05ea\u05d9 \u05d4\u05de\u05de\u05d5\u05e7\u05dd \u05d1\u05dc\u05d1 \u05d4\u05e8\u05e6\u05dc\u05d9\u05d4, \u05d4\u05de\u05ea\u05de\u05d7\u05d4 \u05d1\u05d0\u05d6\u05d5\u05e8\u05d9 \u05d4\u05d9\u05d5\u05e7\u05e8\u05d4 \u05e9\u05dc \u05d4\u05e9\u05e8\u05d5\u05df \u05d5\u05ea\u05dc \u05d0\u05d1\u05d9\u05d1. \u05db\u05de\u05d9 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05d0\u05ea \u05d4\u05de\u05e9\u05e8\u05d3 \u05e2\u05dd \u05ea\u05d5\u05d0\u05e8 \u05e9\u05e0\u05d9 \u05d1\u05de\u05e0\u05d4\u05dc \u05e2\u05e1\u05e7\u05d9\u05dd \u05d5\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05e2\u05e9\u05d9\u05e8 \u05d1\u05de\u05db\u05d9\u05e8\u05d5\u05ea \u05e0\u05d3\u05dc\"\u05df, \u05d0\u05e0\u05d9 \u05de\u05d1\u05d9\u05d0 \u05d0\u05d9\u05ea\u05d9 \u05e8\u05d0\u05d9\u05d9\u05d4 \u05e2\u05e1\u05e7\u05d9\u05ea \u05e8\u05d7\u05d1\u05d4, \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05e0\u05d9\u05ea\u05d5\u05d7 \u05e9\u05d5\u05e7 \u05de\u05ea\u05e7\u05d3\u05de\u05d5\u05ea \u05d5\u05e0\u05d9\u05d4\u05d5\u05dc \u05de\u05e9\u05d0 \u05d5\u05de\u05ea\u05df \u05d7\u05e1\u05e8 \u05e4\u05e9\u05e8\u05d5\u05ea. \n \u05d0\u05e6\u05dc\u05e0\u05d5 \u05d1-BARHOME, \u05db\u05dc \u05e2\u05e1\u05e7\u05d4 \u05d4\u05d9\u05d0 \u05e9\u05dc\u05d9\u05d7\u05d5\u05ea. \u05d0\u05e0\u05d7\u05e0\u05d5 \u05d7\u05d5\u05e8\u05d8\u05d9\u05dd \u05e2\u05dc \u05d3\u05d2\u05dc\u05e0\u05d5 \u05d0\u05ea \u05e2\u05e8\u05db\u05d9 \u05d4\u05de\u05e7\u05e6\u05d5\u05e2\u05d9\u05d5\u05ea, \u05d4\u05d0\u05de\u05d9\u05e0\u05d5\u05ea \u05d5\u05d4\u05e9\u05e7\u05d9\u05e4\u05d5\u05ea, \u05d5\u05de\u05d1\u05d8\u05d9\u05d7\u05d9\u05dd \u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05d9\u05d5\u05e6\u05d0\u05d5\u05ea \u05d3\u05d5\u05e4\u05df \u05d1\u05d6\u05de\u05df \u05e7\u05e6\u05e8, \u05ea\u05d5\u05da \u05dc\u05d9\u05d5\u05d5\u05d9 \u05d0\u05d9\u05e9\u05d9 \u05e9\u05e2\u05d5\u05d8\u05e3 \u05d0\u05ea\u05db\u05dd \u05dc\u05d0\u05d5\u05e8\u05da \u05db\u05dc \u05d4\u05d3\u05e8\u05da. \n\n\n\n\n\u05d4\u05e9\u05d9\u05e8\u05d5\u05ea\u05d9\u05dd \u05d4\u05de\u05e7\u05e6\u05d5\u05e2\u05d9\u05d9\u05dd \u05e9\u05dc\u05e0\u05d5\n\n\n\n\u05e9\u05d9\u05d5\u05d5\u05e7 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8\u05d9\u05dd\n\u05dc\u05d9\u05d5\u05d5\u05d9 \u05e7\u05d1\u05dc\u05e0\u05d9\u05dd \u05d5\u05d9\u05d6\u05de\u05d9\u05dd \u05d1\u05e9\u05d9\u05d5\u05d5\u05e7 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8\u05d9\u05dd \u05d9\u05d3 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d4, \u05d4\u05d7\u05dc \u05de\u05e9\u05dc\u05d1 \u05d4\u05ea\u05db\u05e0\u05d5\u05df \u05d5\u05e2\u05d3 \u05dc\u05de\u05d9\u05ea\u05d5\u05d2 \u05d5\u05de\u05db\u05d9\u05e8\u05d4 \u05e1\u05d5\u05e4\u05d9\u05ea \u05dc\u05e7\u05d4\u05dc \u05d4\u05d9\u05e2\u05d3.\n\n\n\n\n\u05d1\u05e0\u05d9\u05d9\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05d5\u05e7\u05e8\u05e7\u05e2\u05d5\u05ea\n\u05de\u05d5\u05de\u05d7\u05d9\u05dd \u05d1\u05e9\u05d9\u05d5\u05d5\u05e7 \u05e7\u05e8\u05e7\u05e2\u05d5\u05ea \u05dc\u05de\u05d2\u05d5\u05e8\u05d9\u05dd \u05d1\u05d1\u05e0\u05d9\u05d9\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05d5\u05dc\u05d4\u05e9\u05e7\u05e2\u05d4, \u05db\u05d5\u05dc\u05dc \u05e0\u05d9\u05ea\u05d5\u05d7 \u05d6\u05db\u05d5\u05d9\u05d5\u05ea \u05d1\u05e0\u05d9\u05d9\u05d4 \u05d5\u05d1\u05d3\u05d9\u05e7\u05ea \u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc.\n\n\n\n\n\u05e0\u05db\u05e1\u05d9 \u05d9\u05d3 2 \u05d5\u05d9\u05d5\u05e7\u05e8\u05d4\n\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e0\u05db\u05e1\u05d9\u05dd \u05e4\u05e8\u05d8\u05d9\u05d9\u05dd, \u05d5\u05d9\u05dc\u05d5\u05ea \u05d5\u05d3\u05d9\u05e8\u05d5\u05ea \u05d9\u05d5\u05e7\u05e8\u05d4 \u05e2\u05dd \u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d9\u05ea \u05e9\u05d9\u05d5\u05d5\u05e7 \u05de\u05d5\u05ea\u05d0\u05de\u05ea \u05d0\u05d9\u05e9\u05d9\u05ea \u05dc\u05db\u05dc \u05e0\u05db\u05e1.\n\n\n\n\n\u05d9\u05d9\u05e2\u05d5\u05e5 \u05d5\u05dc\u05d9\u05d5\u05d5\u05d9 \u05de\u05d5\"\u05de\n\u05e0\u05d9\u05d4\u05d5\u05dc \u05ea\u05d4\u05dc\u05d9\u05db\u05d9 \u05de\u05db\u05d9\u05e8\u05d4 \u05d5\u05e7\u05e0\u05d9\u05d9\u05d4 \u05de\u05d5\u05e8\u05db\u05d1\u05d9\u05dd \u05d1\u05d2\u05d9\u05e9\u05d4 \u05e2\u05e1\u05e7\u05d9\u05ea \u05e9\u05e7\u05d5\u05dc\u05d4, \u05d4\u05de\u05d1\u05d8\u05d9\u05d7\u05d4 \u05d0\u05ea \u05d4\u05ea\u05e0\u05d0\u05d9\u05dd \u05d4\u05d8\u05d5\u05d1\u05d9\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8.\n\n\n\n\n\n\n\u05d4\u05e2\u05e8\u05db\u05d9\u05dd \u05e9\u05de\u05d5\u05d1\u05d9\u05dc\u05d9\u05dd \u05d0\u05d5\u05ea\u05e0\u05d5\n\n\n\n\u05d0\u05ea\u05d9\u05e7\u05d4 \u05d5\u05d9\u05d5\u05e9\u05e8\u05d4\n\u05e2\u05d1\u05d5\u05d3\u05d4 \u05d1\u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9\u05dd \u05d1\u05d9\u05e0\u05dc\u05d0\u05d5\u05de\u05d9\u05d9\u05dd \u05e9\u05dc \u05e9\u05e7\u05d9\u05e4\u05d5\u05ea \u05de\u05dc\u05d0\u05d4. \u05d0\u05e0\u05d7\u05e0\u05d5 \u05de\u05d0\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05d4\u05d0\u05de\u05ea \u05d4\u05d9\u05d0 \u05d4\u05d1\u05e1\u05d9\u05e1 \u05dc\u05db\u05dc \u05e2\u05e1\u05e7\u05d4 \u05de\u05d5\u05e6\u05dc\u05d7\u05ea.\n\n\n\n\n\u05e7\u05d9\u05e6\u05d5\u05e8 \u05d3\u05e8\u05da \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\n\u05d6\u05de\u05df \u05d4\u05d5\u05d0 \u05d4\u05de\u05e9\u05d0\u05d1 \u05d4\u05d9\u05e7\u05e8 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc\u05db\u05dd. \u05d0\u05e0\u05d7\u05e0\u05d5 \u05d7\u05d5\u05e1\u05db\u05d9\u05dd \u05dc\u05db\u05dd \u05e4\u05d2\u05d9\u05e9\u05d5\u05ea \u05de\u05d9\u05d5\u05ea\u05e8\u05d5\u05ea \u05d5\u05de\u05d1\u05d9\u05d0\u05d9\u05dd \u05e8\u05e7 \u05d0\u05ea \u05d4\u05e7\u05d5\u05e0\u05d9\u05dd \u05d0\u05d5 \u05d4\u05e0\u05db\u05e1\u05d9\u05dd \u05d4\u05de\u05d3\u05d5\u05d9\u05e7\u05d9\u05dd.\n\n\n\n\n\u05d7\u05d1\u05e8 \u05de\u05e9\u05e4\u05d7\u05d4\n\u05d0\u05e0\u05d7\u05e0\u05d5 \u05de\u05ea\u05d9\u05d9\u05d7\u05e1\u05d9\u05dd \u05dc\u05db\u05dc \u05dc\u05e7\u05d5\u05d7 \u05db\u05d7\u05dc\u05e7 \u05de\u05d4\u05de\u05e9\u05e4\u05d7\u05d4. \u05d4\u05e6\u05e8\u05db\u05d9\u05dd \u05e9\u05dc\u05db\u05dd \u05e2\u05d5\u05de\u05d3\u05d9\u05dd \u05dc\u05e0\u05d2\u05d3 \u05e2\u05d9\u05e0\u05d9\u05e0\u05d5 \u05de\u05e2\u05dc \u05dc\u05db\u05dc \u05e9\u05d9\u05e7\u05d5\u05dc \u05d0\u05d7\u05e8.\n\n\n\n\n\n\n\n\u05e9\u05d0\u05dc\u05d5\u05ea \u05e0\u05e4\u05d5\u05e6\u05d5\u05ea\n\n\n\u05dc\u05de\u05d4 \u05db\u05d3\u05d0\u05d9 \u05dc\u05d1\u05d7\u05d5\u05e8 \u05d1\u05de\u05e9\u05e8\u05d3 \u05d1\u05d5\u05d8\u05d9\u05e7 \u05e2\u05dc \u05e4\u05e0\u05d9 \u05e8\u05e9\u05ea \u05d2\u05d3\u05d5\u05dc\u05d4? \u25bc\n\u05d1\u05de\u05e9\u05e8\u05d3 \u05d1\u05d5\u05d8\u05d9\u05e7 \u05db\u05de\u05d5 BARHOME, \u05d4\u05e0\u05db\u05e1 \u05e9\u05dc\u05db\u05dd \u05d4\u05d5\u05d0 \u05dc\u05d0 \u05e2\u05d5\u05d3 \u05de\u05e1\u05e4\u05e8 \u05d1\u05de\u05e2\u05e8\u05db\u05ea. \u05d0\u05ea\u05dd \u05de\u05e7\u05d1\u05dc\u05d9\u05dd \u05ea\u05e9\u05d5\u05de\u05ea \u05dc\u05d1 \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9\u05ea, \u05dc\u05d9\u05d5\u05d5\u05d9 \u05e9\u05dc \u05d1\u05e2\u05dc \u05d4\u05de\u05e9\u05e8\u05d3 \u05e2\u05e6\u05de\u05d5 \u05d5\u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d4 \u05e9\u05ea\u05e4\u05d5\u05e8\u05d4 \u05d1\u05d3\u05d9\u05d5\u05e7 \u05dc\u05de\u05d9\u05d3\u05d5\u05ea \u05e9\u05dc\u05db\u05dd, \u05d5\u05dc\u05d0 \u05ea\u05d1\u05e0\u05d9\u05ea \u05e9\u05d9\u05d5\u05d5\u05e7\u05d9\u05ea \u05d0\u05d7\u05d9\u05d3\u05d4.\n\n\n\n\u05de\u05d4 \u05db\u05d5\u05dc\u05dc \u05ea\u05d4\u05dc\u05d9\u05da \u05dc\u05d9\u05d5\u05d5\u05d9 \u05de\u05e9\u05e4\u05e8\u05d9 \u05d4\u05d3\u05d9\u05d5\u05e8? \u25bc\n\u05d4\u05ea\u05d4\u05dc\u05d9\u05da \u05db\u05d5\u05dc\u05dc \u05d4\u05e2\u05e8\u05db\u05ea \u05e9\u05d5\u05d5\u05d9 \u05e8\u05d9\u05d0\u05dc\u05d9\u05ea \u05e9\u05dc \u05d4\u05e0\u05db\u05e1 \u05d4\u05e7\u05d9\u05d9\u05dd, \u05d1\u05e0\u05d9\u05d9\u05ea \u05dc\u05d5\u05d7\u05d5\u05ea \u05d6\u05de\u05e0\u05d9\u05dd \u05dc\u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05d1\u05d9\u05df \u05d4\u05de\u05db\u05d9\u05e8\u05d4 \u05dc\u05e7\u05e0\u05d9\u05d9\u05d4, \u05d0\u05d9\u05ea\u05d5\u05e8 \u05d4\u05e0\u05db\u05e1 \u05d4\u05d1\u05d0 \u05d5\u05e0\u05d9\u05d4\u05d5\u05dc \u05de\u05e9\u05d0 \u05d5\u05de\u05ea\u05df \u05db\u05e4\u05d5\u05dc \u05e9\u05e9\u05d5\u05de\u05e8 \u05e2\u05dc \u05d4\u05d1\u05d9\u05d8\u05d7\u05d5\u05df \u05d4\u05db\u05dc\u05db\u05dc\u05d9 \u05e9\u05dc\u05db\u05dd.\n\n\n\n\u05d4\u05d0\u05dd \u05d0\u05ea\u05dd \u05e2\u05d5\u05d1\u05d3\u05d9\u05dd \u05e2\u05dd \u05e2\u05d5\u05e8\u05db\u05d9 \u05d3\u05d9\u05df \u05d5\u05d0\u05e0\u05e9\u05d9 \u05de\u05e7\u05e6\u05d5\u05e2 \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd? \u25bc\n\u05db\u05df, \u05d9\u05e9 \u05dc\u05e0\u05d5 \u05e8\u05e9\u05ea \u05e9\u05dc \u05d0\u05e0\u05e9\u05d9 \u05de\u05e7\u05e6\u05d5\u05e2 \u05de\u05df \u05d4\u05e9\u05d5\u05e8\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 - \u05e2\u05d5\u05e8\u05db\u05d9 \u05d3\u05d9\u05df \u05de\u05d5\u05de\u05d7\u05d9\u05dd \u05dc\u05e0\u05d3\u05dc\"\u05df, \u05e9\u05de\u05d0\u05d9\u05dd, \u0