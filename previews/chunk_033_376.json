        "Abstract": " \u05e7\u05d5\u05d1\u05d9 \u05de\u05ea\u05ea\u05d9\u05d4\u05d5 \u05d4\u05d9\u05e0\u05d5 \u05e2\u05d5\u05e8\u05da \u05d3\u05d9\u05df \u05d7\u05d5\u05d6\u05d9\u05dd \u05d5\u05d4\u05e1\u05db\u05de\u05d9\u05dd \u05de\u05e1\u05d7\u05e8\u05d9 \u05d4\u05de\u05ea\u05de\u05d7\u05d4 \u05d1\u05d3\u05d9\u05e0\u05d9 \u05d4\u05d7\u05d5\u05d6\u05d9\u05dd \u05d5\u05d4\u05de\u05e9\u05e4\u05d8 \u05d4\u05de\u05e1\u05d7\u05e8\u05d9, \u05db\u05de\u05e9\u05e8\u05d3 \u05e2\u05d5\"\u05d3 \u05dc\u05d7\u05d5\u05d6\u05d9\u05dd \u05d5\u05d4\u05e1\u05db\u05de\u05d9\u05dd \u05de\u05e1\u05d7\u05e8\u05d9\u05d9\u05dd \u05e0\u05d3\u05e2 \u05dc\u05d9\u05d9\u05e2\u05e5 \u05d1\u05e2\u05e0\u05d9\u05d9\u05e0\u05d9 \u05d7\u05d5\u05d6\u05d9\u05dd, \u05de\u05e9\u05e4\u05d8 \u05de\u05e1\u05d7\u05e8\u05d9 \u05e2\u05e1\u05e7\u05d9 \u05d5\u05d1\u05ea\u05d7\u05d5\u05de\u05d9 \u05d4\u05de\u05e9\u05e4\u05d8 \u05d4\u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05dd \u05dc\u05e2\u05e1\u05e7\u05d9\u05dd \u05d5\u05d7\u05d1\u05e8\u05d5\u05ea \u05db\u05d2\u05d5\u05df: \u05e8\u05d9\u05e9\u05d5\u05d9 \u05e2\u05e1\u05e7\u05d9\u05dd, \u05d3\u05d9\u05e0\u05d9 \u05d7\u05d1\u05e8\u05d5\u05ea, \u05e2\u05d5\u05d5\u05dc\u05d5\u05ea \u05de\u05e1\u05d7\u05e8\u05d9\u05d5\u05ea, \u05d7\u05d5\u05d6\u05d9\u05dd \u05d0\u05d7\u05d9\u05d3\u05d9\u05dd \u05d5\u05db\u05d9\u05d5\"\u05d1...\u05e7\u05d5\u05d1\u05d9 \u05de\u05ea\u05ea\u05d9\u05d4\u05d5 \u05de\u05e9\u05e8\u05d3 \u05e2\u05d5\u05e8\u05da \u05d3\u05d9\u05df \u05de\u05e1\u05d7\u05e8\u05d9 \u05dc\u05e2\u05e1\u05e7\u05d9\u05dd, \u05d3\u05d9\u05e0\u05d9 \u05d7\u05d5\u05d6\u05d9\u05dd \u05d5\u05d4\u05e1\u05db\u05de\u05d9\u05dd \u05de\u05e9\u05e4\u05d8\u05d9\u05d9\u05dd, \u05e6\u05d5\u05d5\u05d0\u05d5\u05ea, \u05d4\u05e1\u05db\u05de\u05d9 \u05de\u05de\u05d5\u05df, \u05d9\u05d9\u05e4\u05d5\u05d9 \u05db\u05d5\u05d7 \u05de\u05ea\u05de\u05e9\u05da \u05d5\u05e0\u05d6\u05d9\u05e7\u05d9\u05df",
        "Official Site": "https://www.law-kobim.com \u05e7\u05d5\u05d1\u05d9 \u05de\u05ea\u05ea\u05d9\u05d4\u05d5 \u05d4\u05d9\u05e0\u05d5 \u05e2\u05d5\u05e8\u05da \u05d3\u05d9\u05df \u05d7\u05d5\u05d6\u05d9\u05dd \u05d5\u05d4\u05e1\u05db\u05de\u05d9\u05dd \u05de\u05e1\u05d7\u05e8\u05d9 \u05d4\u05de\u05ea\u05de\u05d7\u05d4 \u05d1\u05d3\u05d9\u05e0\u05d9 \u05d4\u05d7\u05d5\u05d6\u05d9\u05dd \u05d5\u05d4\u05de\u05e9\u05e4\u05d8 \u05d4\u05de\u05e1\u05d7\u05e8\u05d9, \u05db\u05de\u05e9\u05e8\u05d3 \u05e2\u05d5\"\u05d3 \u05dc\u05d7\u05d5\u05d6\u05d9\u05dd \u05d5\u05d4\u05e1\u05db\u05de\u05d9\u05dd \u05de\u05e1\u05d7\u05e8\u05d9\u05d9\u05dd \u05e0\u05d3\u05e2 \u05dc\u05d9\u05d9\u05e2\u05e5 \u05d1\u05e2\u05e0\u05d9\u05d9\u05e0\u05d9 \u05d7\u05d5\u05d6\u05d9\u05dd, \u05de\u05e9\u05e4\u05d8 \u05de\u05e1\u05d7\u05e8\u05d9 \u05e2\u05e1\u05e7\u05d9 \u05d5\u05d1\u05ea\u05d7\u05d5\u05de\u05d9 \u05d4\u05de\u05e9\u05e4\u05d8 \u05d4\u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05dd \u05dc\u05e2\u05e1\u05e7\u05d9\u05dd \u05d5\u05d7\u05d1\u05e8\u05d5\u05ea \u05db\u05d2\u05d5\u05df: \u05e8\u05d9\u05e9\u05d5\u05d9 \u05e2\u05e1\u05e7\u05d9\u05dd, \u05d3\u05d9\u05e0\u05d9 \u05d7\u05d1\u05e8\u05d5\u05ea, \u05e2\u05d5\u05d5\u05dc\u05d5\u05ea \u05de\u05e1\u05d7\u05e8\u05d9\u05d5\u05ea, \u05d7\u05d5\u05d6\u05d9\u05dd \u05d0\u05d7\u05d9\u05d3\u05d9\u05dd \u05d5\u05db\u05d9\u05d5\"\u05d1... \u05e7\u05d5\u05d1\u05d9 \u05de\u05ea\u05ea\u05d9\u05d4\u05d5 \u05e2\u05d5\u05e8\u05da \u05d3\u05d9\u05df \u05de\u05e1\u05d7\u05e8\u05d9 \u05de\u05e7\u05e6\u05d5\u05e2\u05d9 \u05dc\u05e2\u05e1\u05e7\u05d9\u05dd, \u05d7\u05d5\u05d6\u05d9\u05dd \u05d5\u05d4\u05e1\u05db\u05de\u05d9\u05dd \u05de\u05e9\u05e4\u05d8\u05d9\u05d9\u05dd, \u05d9\u05d9\u05e4\u05d5\u05d9 \u05db\u05d5\u05d7 \u05de\u05ea\u05de\u05e9\u05da \u05e2\u05e8\u05d9\u05db\u05ea \u05d4\u05e1\u05db\u05de\u05d9 \u05de\u05de\u05d5\u05df \u05d5\u05e6\u05d5\u05d5\u05d0\u05d5\u05ea",
        "Icon": "https://static.wixstatic.com/media/273219_9c90309da7b34ea5856e4d3e4e3445dc.jpg/v1/fit/w_2500,h_1330,al_c/273219_9c90309da7b34ea5856e4d3e4e3445dc.jpg",
        "Redirect": "https://www.law-kobim.com \u05e7\u05d5\u05d1\u05d9 \u05de\u05ea\u05ea\u05d9\u05d4\u05d5 \u05d4\u05d9\u05e0\u05d5 \u05e2\u05d5\u05e8\u05da \u05d3\u05d9\u05df \u05d7\u05d5\u05d6\u05d9\u05dd \u05d5\u05d4\u05e1\u05db\u05de\u05d9\u05dd \u05de\u05e1\u05d7\u05e8\u05d9 \u05d4\u05de\u05ea\u05de\u05d7\u05d4 \u05d1\u05d3\u05d9\u05e0\u05d9 \u05d4\u05d7\u05d5\u05d6\u05d9\u05dd \u05d5\u05d4\u05de\u05e9\u05e4\u05d8 \u05d4\u05de\u05e1\u05d7\u05e8\u05d9, \u05db\u05de\u05e9\u05e8\u05d3 \u05e2\u05d5\"\u05d3 \u05dc\u05d7\u05d5\u05d6\u05d9\u05dd \u05d5\u05d4\u05e1\u05db\u05de\u05d9\u05dd \u05de\u05e1\u05d7\u05e8\u05d9\u05d9\u05dd \u05e0\u05d3\u05e2 \u05dc\u05d9\u05d9\u05e2\u05e5 \u05d1\u05e2\u05e0\u05d9\u05d9\u05e0\u05d9 \u05d7\u05d5\u05d6\u05d9\u05dd, \u05de\u05e9\u05e4\u05d8 \u05de\u05e1\u05d7\u05e8\u05d9 \u05e2\u05e1\u05e7\u05d9 \u05d5\u05d1\u05ea\u05d7\u05d5\u05de\u05d9 \u05d4\u05de\u05e9\u05e4\u05d8 \u05d4\u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05dd \u05dc\u05e2\u05e1\u05e7\u05d9\u05dd \u05d5\u05d7\u05d1\u05e8\u05d5\u05ea \u05db\u05d2\u05d5\u05df: \u05e8\u05d9\u05e9\u05d5\u05d9 \u05e2\u05e1\u05e7\u05d9\u05dd, \u05d3\u05d9\u05e0\u05d9 \u05d7\u05d1\u05e8\u05d5\u05ea, \u05e2\u05d5\u05d5\u05dc\u05d5\u05ea \u05de\u05e1\u05d7\u05e8\u05d9\u05d5\u05ea, \u05d7\u05d5\u05d6\u05d9\u05dd \u05d0\u05d7\u05d9\u05d3\u05d9\u05dd \u05d5\u05db\u05d9\u05d5\"\u05d1... \u05e7\u05d5\u05d1\u05d9 \u05de\u05ea\u05ea\u05d9\u05d4\u05d5 \u05e2\u05d5\u05e8\u05da \u05d3\u05d9\u05df \u05de\u05e1\u05d7\u05e8\u05d9 \u05de\u05e7\u05e6\u05d5\u05e2\u05d9 \u05dc\u05e2\u05e1\u05e7\u05d9\u05dd, \u05d7\u05d5\u05d6\u05d9\u05dd \u05d5\u05d4\u05e1\u05db\u05de\u05d9\u05dd \u05de\u05e9\u05e4\u05d8\u05d9\u05d9\u05dd, \u05d9\u05d9\u05e4\u05d5\u05d9 \u05db\u05d5\u05d7 \u05de\u05ea\u05de\u05e9\u05da \u05e2\u05e8\u05d9\u05db\u05ea \u05d4\u05e1\u05db\u05de\u05d9 \u05de\u05de\u05d5\u05df \u05d5\u05e6\u05d5\u05d5\u05d0\u05d5\u05ea",
        "AbstractSource": "BS4",
        "AbstractURL": "https://www.law-kobim.com \u05e7\u05d5\u05d1\u05d9 \u05de\u05ea\u05ea\u05d9\u05d4\u05d5 \u05d4\u05d9\u05e0\u05d5 \u05e2\u05d5\u05e8\u05da \u05d3\u05d9\u05df \u05d7\u05d5\u05d6\u05d9\u05dd \u05d5\u05d4\u05e1\u05db\u05de\u05d9\u05dd \u05de\u05e1\u05d7\u05e8\u05d9 \u05d4\u05de\u05ea\u05de\u05d7\u05d4 \u05d1\u05d3\u05d9\u05e0\u05d9 \u05d4\u05d7\u05d5\u05d6\u05d9\u05dd \u05d5\u05d4\u05de\u05e9\u05e4\u05d8 \u05d4\u05de\u05e1\u05d7\u05e8\u05d9, \u05db\u05de\u05e9\u05e8\u05d3 \u05e2\u05d5\"\u05d3 \u05dc\u05d7\u05d5\u05d6\u05d9\u05dd \u05d5\u05d4\u05e1\u05db\u05de\u05d9\u05dd \u05de\u05e1\u05d7\u05e8\u05d9\u05d9\u05dd \u05e0\u05d3\u05e2 \u05dc\u05d9\u05d9\u05e2\u05e5 \u05d1\u05e2\u05e0\u05d9\u05d9\u05e0\u05d9 \u05d7\u05d5\u05d6\u05d9\u05dd, \u05de\u05e9\u05e4\u05d8 \u05de\u05e1\u05d7\u05e8\u05d9 \u05e2\u05e1\u05e7\u05d9 \u05d5\u05d1\u05ea\u05d7\u05d5\u05de\u05d9 \u05d4\u05de\u05e9\u05e4\u05d8 \u05d4\u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05dd \u05dc\u05e2\u05e1\u05e7\u05d9\u05dd \u05d5\u05d7\u05d1\u05e8\u05d5\u05ea \u05db\u05d2\u05d5\u05df: \u05e8\u05d9\u05e9\u05d5\u05d9 \u05e2\u05e1\u05e7\u05d9\u05dd, \u05d3\u05d9\u05e0\u05d9 \u05d7\u05d1\u05e8\u05d5\u05ea, \u05e2\u05d5\u05d5\u05dc\u05d5\u05ea \u05de\u05e1\u05d7\u05e8\u05d9\u05d5\u05ea, \u05d7\u05d5\u05d6\u05d9\u05dd \u05d0\u05d7\u05d9\u05d3\u05d9\u05dd \u05d5\u05db\u05d9\u05d5\"\u05d1... \u05e7\u05d5\u05d1\u05d9 \u05de\u05ea\u05ea\u05d9\u05d4\u05d5 \u05e2\u05d5\u05e8\u05da \u05d3\u05d9\u05df \u05de\u05e1\u05d7\u05e8\u05d9 \u05de\u05e7\u05e6\u05d5\u05e2\u05d9 \u05dc\u05e2\u05e1\u05e7\u05d9\u05dd, \u05d7\u05d5\u05d6\u05d9\u05dd \u05d5\u05d4\u05e1\u05db\u05de\u05d9\u05dd \u05de\u05e9\u05e4\u05d8\u05d9\u05d9\u05dd, \u05d9\u05d9\u05e4\u05d5\u05d9 \u05db\u05d5\u05d7 \u05de\u05ea\u05de\u05e9\u05da \u05e2\u05e8\u05d9\u05db\u05ea \u05d4\u05e1\u05db\u05de\u05d9 \u05de\u05de\u05d5\u05df \u05d5\u05e6\u05d5\u05d5\u05d0\u05d5\u05ea"
