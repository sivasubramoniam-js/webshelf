        "link": "https://kellana5060.org",
        "Heading": "\u062c\u0645\u0639\u064a\u0629 \u0627\u0644\u0623\u0645\u064a\u0631 \u0641\u0647\u062f \u0628\u0646 \u0633\u0644\u0645\u0627\u0646 \u0627\u0644\u062e\u064a\u0631\u064a\u0629 \u0644\u0631\u0639\u0627\u064a\u0629 \u0645\u0631\u0636\u0649 \u0627\u0644\u0641\u0634\u0644 \u0627\u0644\u0643\u0644\u0648\u064a \"\u0643\u0644\u0627\u0646\u0627\"",
        "Abstract": "\u062c\u0645\u0639\u064a\u0629 \u0627\u0644\u0623\u0645\u064a\u0631 \u0641\u0647\u062f \u0628\u0646 \u0633\u0644\u0645\u0627\u0646 \u0627\u0644\u062e\u064a\u0631\u064a\u0629 \u0644\u0631\u0639\u0627\u064a\u0629 \u0645\u0631\u0636\u0649 \u0627\u0644\u0641\u0634\u0644 \u0627\u0644\u0643\u0644\u0648\u064a \u062a\u0623\u0633\u0633\u062a \u0628\u0645\u0628\u0627\u062f\u0631\u0629 \u0643\u0631\u064a\u0645\u0629 \u0645\u0646 \u062e\u0627\u062f\u0645 \u0627\u0644\u062d\u0631\u0645\u064a\u0646 \u0627\u0644\u0634\u0631\u064a\u0641\u064a\u0646\n\u0627\u0644\u0645\u0644\u0643 \u0633\u0644\u0645\u0627\u0646 \u0628\u0646 \u0639\u0628\u062f \u0627\u0644\u0639\u0632\u064a\u0632 \u2013 \u062d\u0641\u0638\u0647 \u0627\u0644\u0644\u0647 \u2013 \u0639\u0646\u062f\u0645\u0627 \u0643\u0627\u0646 \u0623\u0645\u064a\u0631 \u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0631\u064a\u0627\u0636 \u2013 \u0628\u0639\u062f \u0623\u0646 \u0644\u0627\u062d\u0638 \u0623\u064a\u062f\u0647 \u0627\u0644\u0644\u0647 \u2013 \u0627\u0632\u062f\u064a\u0627\u062f \u0623\u0639\u062f\u0627\u062f \u0645\u0631\u0636\u0649\n\u0627\u0644\u0641\u0634\u0644 \u0627\u0644\u0643\u0644\u0648\u064a \u0627\u0644\u0646\u0647\u0627\u0626\u064a \u0628\u0634\u0643\u0644 \u0645\u0637\u0631\u062f \u062d\u064a\u062b \u0648\u0635\u0644 \u0639\u062f\u062f\u0647\u0645 \u0641\u064a \u0639\u0627\u0645 1424\u0647\u0640 \u0625\u0644\u0649 \u0623\u0643\u062b\u0631 \u0645\u0646 (9,600 \u0645\u0631\u064a\u0636)\u060c \u0628\u064a\u0646\u0645\u0627 \u0643\u0627\u0646 \u0639\u062f\u062f\u0647\u0645\n\u062d\u0633\u0628 \u0625\u062d\u0635\u0627\u0626\u064a\u0629 \u0639\u0627\u0645 1401\u0647\u0640 \u0644\u0627 \u064a\u062a\u062c\u0627\u0648\u0632 (83 \u0645\u0631\u064a\u0636)\u060c \u0641\u0643\u0627\u0646\u062a \u0645\u0628\u0627\u062f\u0631\u062a\u0647 \u0627\u0644\u0643\u0631\u064a\u0645\u0629 \u0628\u0625\u0646\u0634\u0627\u0621 \u062c\u0645\u0639\u064a\u0629 \u062e\u064a\u0631\u064a\u0629 \u062a\u0647\u062f\u0641 \u0625\u0644\u0649 \u062e\u062f\u0645\u0629 \u0645\u0631\u0636\u0649\n\u0627\u0644\u0641\u0634\u0644 \u0627\u0644\u0643\u0644\u0648\u064a \u0648\u0645\u0633\u0627\u0639\u062f\u062a\u0647\u0645 \u0635\u062d\u064a\u0627\u064b \u0648\u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0627 \u0648\u0628\u0646\u0627\u0621 \u0639\u0644\u0649 \u0630\u0644\u0643 \u0635\u062f\u0631\u062a \u0645\u0648\u0627\u0641\u0642\u0629 \u0645\u0639\u0627\u0644\u064a \u0648\u0632\u064a\u0631 \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629 \u0648\u0627\u0644\u062a\u0646\u0645\u064a\u0629\n\u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629 \u0631\u0642\u0645 19078 \u0648\u062a\u0627\u0631\u064a\u062e 1421/6/19\u0647\u0640 \u0628\u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u062c\u0645\u0639\u064a\u0629 \u0627\u0644\u062e\u064a\u0631\u064a\u0629 \u0644\u0631\u0639\u0627\u064a\u0629 \u0645\u0631\u0636\u0649 \u0627\u0644\u0641\u0634\u0644 \u0627\u0644\u0643\u0644\u0648\u064a \u0648\u0627\u0646\u0639\u0642\u062f \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\n\u0627\u0644\u062a\u0623\u0633\u064a\u0633\u064a \u0644\u0644\u062c\u0645\u0639\u064a\u0629 \u0641\u064a \u064a\u0648\u0645 \u0627\u0644\u0623\u062d\u062f \u0627\u0644\u0645\u0648\u0627\u0641\u0642 1422/3/11\u0647\u0640.",
